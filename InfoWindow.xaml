<Window x:Class="OctavianRSM.InfoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="OctavianRSM" Width="560" Height="460"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource B.Bg1}" Foreground="{StaticResource B.Text}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="TxtTitle" Style="{StaticResource OctaPageTitle}"/>
        <Border Grid.Row="1" Style="{StaticResource OctaPanel}" Padding="12" Margin="0,10,0,10">
            <TextBox x:Name="TxtBody" IsReadOnly="True" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     FontFamily="Consolas" FontSize="12"
                     Background="Transparent" BorderThickness="0"
                     Foreground="{StaticResource B.Text}"/>
        </Border>
        <ui:Button Grid.Row="2" Content="ЗАКРЫТЬ" Appearance="Secondary"
                   HorizontalAlignment="Right" Padding="18,6" Click="Close_Click"/>
    </Grid>
</Window>
