<Page x:Class="OctavianRSM.Pages.ConsolePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:octa="clr-namespace:OctavianRSM.Controls"
      ScrollViewer.CanContentScroll="False"
      Title="Консоль">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,14" LastChildFill="False">
            <StackPanel>
                <TextBlock Style="{StaticResource OctaPageTitle}" Text="Консоль"/>
                <TextBlock x:Name="TxtSub" Style="{StaticResource OctaPageSub}" Text="RCON websocket"/>
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <ui:Button Content="Переподключить" Click="Connect_Click" Margin="4"/>
                <ui:Button Content="Очистить" Click="Clear_Click" Margin="4"/>
            </StackPanel>
        </DockPanel>

        <!-- фильтры как в RSM Web: тип + свободный текст -->
        <Border Grid.Row="1" Style="{StaticResource OctaPanel}" Margin="0,0,0,10" Padding="10,8">
            <DockPanel LastChildFill="True">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <ui:Button x:Name="FAll" Content="ВСЕ" Appearance="Primary" Padding="12,4" FontSize="11" Click="Filter_Click" Margin="0,0,6,0"/>
                    <ui:Button x:Name="FErr" Content="ERR" Padding="12,4" FontSize="11" Click="Filter_Click" Margin="0,0,6,0"/>
                    <ui:Button x:Name="FChat" Content="CHAT" Padding="12,4" FontSize="11" Click="Filter_Click" Margin="0,0,6,0"/>
                    <ui:Button x:Name="FSys" Content="SYS" Padding="12,4" FontSize="11" Click="Filter_Click" Margin="0,0,12,0"/>
                </StackPanel>
                <ui:Button DockPanel.Dock="Right" Content="КОПИРОВАТЬ" Padding="12,4" FontSize="11"
                           Click="Copy_Click" Margin="12,0,0,0"/>
                <ui:TextBox x:Name="TxtFilter" PlaceholderText="фильтр по тексту…"
                            TextChanged="TxtFilter_TextChanged" FontSize="12"/>
            </DockPanel>
        </Border>

        <octa:LogViewer x:Name="Log" Grid.Row="2"/>

        <Border Grid.Row="3" Style="{StaticResource OctaPanel}" Margin="0,12,0,0" Padding="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="❯" Foreground="{StaticResource B.Accent}" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" Margin="4,0,10,0"/>
                <TextBox x:Name="TxtCmd" Grid.Column="1" FontFamily="Consolas" FontSize="14"
                         Background="Transparent" BorderThickness="0" Foreground="{StaticResource B.Text}"
                         CaretBrush="{StaticResource B.Accent}" KeyDown="TxtCmd_KeyDown" VerticalContentAlignment="Center"/>
                <ui:Button Grid.Column="2" Content="ОТПРАВИТЬ" Appearance="Primary" Margin="10,0,0,0" Click="Send_Click"/>
            </Grid>
        </Border>
    </Grid>
</Page>
