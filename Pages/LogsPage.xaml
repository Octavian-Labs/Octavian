<Page x:Class="OctavianRSM.Pages.LogsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:octa="clr-namespace:OctavianRSM.Controls"
      ScrollViewer.CanContentScroll="False"
      Title="Логи">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,10" LastChildFill="False">
            <StackPanel>
                <TextBlock Style="{StaticResource OctaPageTitle}" Text="Логи"/>
                <TextBlock x:Name="TxtSub" Style="{StaticResource OctaPageSub}"
                           Text="живой журнал сервера и файлы логов Carbon / RSM"/>
            </StackPanel>
        </DockPanel>

        <TabControl Grid.Row="1">
            <!-- ЖИВОЙ ЖУРНАЛ: stdout процесса + tail server.log + история из БД -->
            <TabItem Header="ЖУРНАЛ СЕРВЕРА">
                <Border Style="{StaticResource OctaPanel}" Padding="0">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" LastChildFill="False" Margin="16,10,16,8">
                            <TextBlock Text="вывод сервера и RCON в реальном времени"
                                       Style="{StaticResource OctaStatLabel}" DockPanel.Dock="Left"
                                       VerticalAlignment="Center"/>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <CheckBox x:Name="ChkAuto" Content="автоскролл" IsChecked="True"
                                          Foreground="{StaticResource B.TextDim}" FontSize="11" VerticalAlignment="Center"
                                          Checked="Auto_Changed" Unchecked="Auto_Changed"/>
                                <ui:Button Content="КОПИРОВАТЬ" FontSize="11" Padding="10,3" Margin="12,0,0,0"
                                           Click="CopyLog_Click"/>
                            </StackPanel>
                        </DockPanel>
                        <octa:LogViewer x:Name="Log" UsePanel="False"/>
                    </DockPanel>
                </Border>
            </TabItem>

            <!-- ФАЙЛЫ: server.log, логи Carbon, логи самого RSM -->
            <TabItem Header="ФАЙЛЫ ЛОГОВ">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <ComboBox x:Name="CmbLog" Width="300" SelectionChanged="CmbLog_Changed"
                                  VerticalContentAlignment="Center"/>
                        <ui:TextBox x:Name="TxtFilter" Width="240" PlaceholderText="фильтр по подстроке…"
                                    Margin="10,0" VerticalContentAlignment="Center" TextChanged="Filter_Changed"/>
                        <ui:Button Content="ПРИМЕНИТЬ" Click="Refresh_Click" Padding="14,6"/>
                        <ui:Button Content="ОБНОВИТЬ СПИСОК" Click="ReloadList_Click" Padding="14,6" Margin="8,0,0,0"
                                   ToolTip="Пересканировать файлы логов"/>
                    </StackPanel>
                    <octa:LogViewer x:Name="FileLog" Grid.Row="1"/>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Page>
