<Page x:Class="OctavianRSM.Pages.LogsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      ScrollViewer.CanContentScroll="False"
      Title="Логи">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,14" LastChildFill="False">
            <StackPanel>
                <TextBlock Style="{StaticResource OctaPageTitle}" Text="Логи"/>
                <TextBlock Style="{StaticResource OctaPageSub}" Text="server.log и логи Carbon"/>
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <ComboBox x:Name="CmbLog" Width="260" SelectionChanged="CmbLog_Changed" VerticalContentAlignment="Center"/>
                <ui:TextBox x:Name="TxtFilter" Width="240" PlaceholderText="фильтр по подстроке…" Margin="10,0" VerticalContentAlignment="Center" KeyDown="Filter_KeyDown"/>
                <ui:Button Content="ПРИМЕНИТЬ" Click="Refresh_Click" Padding="14,6"/>
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="1" Style="{StaticResource OctaPanel}" Padding="0">
            <ScrollViewer x:Name="Scroll" Margin="12">
                <TextBlock x:Name="TxtLog" FontFamily="Consolas" FontSize="12"
                           Foreground="{StaticResource B.TextDim}" TextWrapping="Wrap"/>
            </ScrollViewer>
        </Border>
    </Grid>
</Page>
