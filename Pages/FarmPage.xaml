<Page x:Class="OctavianRSM.Pages.FarmPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      ScrollViewer.CanContentScroll="False"
      Title="Ферма">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,14">
            <TextBlock Style="{StaticResource OctaPageTitle}" Text="Ферма"/>
            <TextBlock Style="{StaticResource OctaPageSub}" Text="скот, плотность животных на карте и рост растений — convars Livestock Update (Oct 2026)"/>
        </StackPanel>

        <TabControl Grid.Row="1">
            <!-- ═══ СКОТ ═══ -->
            <TabItem Header="СКОТ">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,4,0,0">
                    <WrapPanel>
                        <Border Style="{StaticResource OctaPanel}" Width="440" Margin="0,0,12,12" Padding="16,14">
                            <StackPanel>
                                <DockPanel LastChildFill="False">
                                    <TextBlock Text="Скорость взросления" Style="{StaticResource OctaCmdTitle}"/>
                                    <TextBlock x:Name="T_Growth" Text="×1.0" DockPanel.Dock="Right" Foreground="{StaticResource B.Accent}" FontWeight="Bold"/>
                                </DockPanel>
                                <TextBlock Text="livestock.agescale — телёнок/ягнёнок до взрослого; ×2 = вдвое быстрее" Style="{StaticResource OctaCmdSub}"/>
                                <Slider x:Name="SldGrowth" Minimum="0.5" Maximum="10" Value="1" TickFrequency="0.5" IsSnapToTickEnabled="True" Margin="0,10,0,4" ValueChanged="Farm_Changed" Tag="T_Growth"/>

                                <CheckBox x:Name="ChkNoAging" Content="Отключить старение вовсе (agescale 0)" Margin="0,8,0,0"/>

                                <DockPanel LastChildFill="False" Margin="0,10,0,0">
                                    <TextBlock Text="Кулдаун разведения (самец)" Style="{StaticResource OctaCmdTitle}"/>
                                    <TextBlock x:Name="T_BreedCd" Text="600 с" DockPanel.Dock="Right" Foreground="{StaticResource B.Accent}" FontWeight="Bold"/>
                                </DockPanel>
                                <TextBlock Text="livestock.breedcooldown — пауза самца между зачатиями" Style="{StaticResource OctaCmdSub}"/>
                                <Slider x:Name="SldBreedCd" Minimum="60" Maximum="3600" Value="600" TickFrequency="60" IsSnapToTickEnabled="True" Margin="0,10,0,4" ValueChanged="Farm_Changed" Tag="T_BreedCd"/>

                                <DockPanel LastChildFill="False" Margin="0,6,0,0">
                                    <TextBlock Text="Кулдаун самки после отёла" Style="{StaticResource OctaCmdTitle}"/>
                                    <TextBlock x:Name="T_Calving" Text="×1.0" DockPanel.Dock="Right" Foreground="{StaticResource B.Accent}" FontWeight="Bold"/>
                                </DockPanel>
                                <TextBlock Text="livestock.calvingcooldownscale — 1 = один выращенный телёнок на роды" Style="{StaticResource OctaCmdSub}"/>
                                <Slider x:Name="SldCalving" Minimum="0" Maximum="5" Value="1" TickFrequency="0.5" IsSnapToTickEnabled="True" Margin="0,10,0,4" ValueChanged="Farm_Changed" Tag="T_Calving"/>

                                <CheckBox x:Name="ChkBreeding" Content="Самостоятельное размножение (livestock.breedingenabled)" IsChecked="True" Margin="0,10,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource OctaPanel}" Width="440" Margin="0,0,12,12" Padding="16,14">
                            <StackPanel>
                                <TextBlock Text="Содержание и логистика" Style="{StaticResource OctaCmdTitle}"/>

                                <CheckBox x:Name="ChkMounting" Content="Погрузка на флэтбеды (livestock.allowmounting)" IsChecked="True" Margin="0,10,0,0"/>
                                <CheckBox x:Name="ChkOvergrazing" Content="Стадо выедает траву (livestock.overgrazingenabled)" IsChecked="True" Margin="0,6,0,0"/>

                                <DockPanel LastChildFill="False" Margin="0,10,0,0">
                                    <TextBlock Text="Восстановление выбитой травы" Style="{StaticResource OctaCmdTitle}"/>
                                    <TextBlock x:Name="T_GrazeCd" Text="30 мин" DockPanel.Dock="Right" Foreground="{StaticResource B.Accent}" FontWeight="Bold"/>
                                </DockPanel>
                                <TextBlock Text="livestock.overgrazedareacooldownminutes" Style="{StaticResource OctaCmdSub}"/>
                                <Slider x:Name="SldGrazeCd" Minimum="5" Maximum="240" Value="30" TickFrequency="5" IsSnapToTickEnabled="True" Margin="0,10,0,4" ValueChanged="Farm_Changed" Tag="T_GrazeCd"/>

                                <DockPanel LastChildFill="False" Margin="0,6,0,0">
                                    <TextBlock Text="Гибель заброшенного животного" Style="{StaticResource OctaCmdTitle}"/>
                                    <TextBlock x:Name="T_Neglect" Text="3600 с" DockPanel.Dock="Right" Foreground="{StaticResource B.Accent}" FontWeight="Bold"/>
                                </DockPanel>
                                <TextBlock Text="livestock.conditionfallseconds — без ухода от здорового до мёртвого" Style="{StaticResource OctaCmdSub}"/>
                                <Slider x:Name="SldNeglect" Minimum="300" Maximum="14400" Value="3600" TickFrequency="300" IsSnapToTickEnabled="True" Margin="0,10,0,4" ValueChanged="Farm_Changed" Tag="T_Neglect"/>

                                <TextBlock Text="Пресеты фермы" Style="{StaticResource OctaFieldLabel}" Margin="0,14,0,4"/>
                                <StackPanel Orientation="Horizontal">
                                    <ui:Button Content="Ванилла" Padding="12,4" Margin="0,0,6,0" Tag="vanilla" Click="FarmPreset_Click"/>
                                    <ui:Button Content="Быстрый рост ×2" Padding="12,4" Margin="0,0,6,0" Tag="fast" Click="FarmPreset_Click"/>
                                    <ui:Button Content="Ферма ×5" Padding="12,4" Margin="0,0,6,0" Tag="farm5" Click="FarmPreset_Click"/>
                                    <ui:Button Content="Вечный молодняк" Padding="12,4" Tag="forever" Click="FarmPreset_Click"/>
                                </StackPanel>

                                <ui:Button Content="⇒ ПРИМЕНИТЬ НАСТРОЙКИ СКОТА" Appearance="Primary" Margin="0,16,0,0" Padding="14,7"
                                           Click="ApplyFarm_Click"
                                           ToolTip="Пишет в server.cfg и отправляет convars по RCON (если подключён)"/>
                            </StackPanel>
                        </Border>
                    </WrapPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ═══ ПЛОТНОСТЬ ═══ -->
            <TabItem Header="ПЛОТНОСТЬ НА КАРТЕ">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,4,0,0">
                    <WrapPanel>
                        <Border Style="{StaticResource OctaPanel}" Width="440" Margin="0,0,12,12" Padding="16,14">
                            <StackPanel>
                                <TextBlock Text="Скот" Style="{StaticResource OctaCmdTitle}"/>
                                <StackPanel x:Name="StackLivestock"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource OctaPanel}" Width="440" Margin="0,0,12,12" Padding="16,14">
                            <StackPanel>
                                <TextBlock Text="Мирные животные" Style="{StaticResource OctaCmdTitle}"/>
                                <StackPanel x:Name="StackPeaceful"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource OctaPanel}" Width="440" Margin="0,0,12,12" Padding="16,14">
                            <StackPanel>
                                <TextBlock Text="Опасные" Style="{StaticResource OctaCmdTitle}"/>
                                <StackPanel x:Name="StackDangerous"/>

                                <TextBlock Text="Пресеты плотности" Style="{StaticResource OctaFieldLabel}" Margin="0,14,0,4"/>
                                <WrapPanel>
                                    <ui:Button Content="Ванилла" Padding="12,4" Margin="0,0,6,6" Tag="vanilla" Click="PopPreset_Click"/>
                                    <ui:Button Content="Редкие ×0.5" Padding="12,4" Margin="0,0,6,6" Tag="sparse" Click="PopPreset_Click"/>
                                    <ui:Button Content="Обильные ×2" Padding="12,4" Margin="0,0,6,6" Tag="dense" Click="PopPreset_Click"/>
                                    <ui:Button Content="Фермерский рай" Padding="12,4" Margin="0,0,6,6" Tag="farm" Click="PopPreset_Click"/>
                                    <ui:Button Content="Пустота" Padding="12,4" Margin="0,0,6,6" Tag="empty" Click="PopPreset_Click"/>
                                </WrapPanel>

                                <ui:Button Content="⇒ ПРИМЕНИТЬ ПЛОТНОСТЬ" Appearance="Primary" Margin="0,10,0,0" Padding="14,7"
                                           Click="ApplyPop_Click"
                                           ToolTip="*.population convars — активная плотность на км²"/>
                            </StackPanel>
                        </Border>
                    </WrapPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ═══ РАСТЕНИЯ ═══ -->
            <TabItem Header="РАСТЕНИЯ">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,4,0,0">
                    <WrapPanel>
                        <Border Style="{StaticResource OctaPanel}" Width="440" Margin="0,0,12,12" Padding="16,14">
                            <StackPanel>
                                <DockPanel LastChildFill="False">
                                    <TextBlock Text="Скорость роста растений" Style="{StaticResource OctaCmdTitle}"/>
                                    <TextBlock x:Name="T_PlantScale" Text="×1.0" DockPanel.Dock="Right" Foreground="{StaticResource B.Accent}" FontWeight="Bold"/>
                                </DockPanel>
                                <TextBlock Text="server.planttickscale — множитель скорости тика роста" Style="{StaticResource OctaCmdSub}"/>
                                <Slider x:Name="SldPlantScale" Minimum="0.5" Maximum="10" Value="1" TickFrequency="0.5" IsSnapToTickEnabled="True" Margin="0,10,0,4" ValueChanged="Farm_Changed" Tag="T_PlantScale"/>

                                <DockPanel LastChildFill="False" Margin="0,6,0,0">
                                    <TextBlock Text="Интервал тика роста" Style="{StaticResource OctaCmdTitle}"/>
                                    <TextBlock x:Name="T_PlantTick" Text="60 с" DockPanel.Dock="Right" Foreground="{StaticResource B.Accent}" FontWeight="Bold"/>
                                </DockPanel>
                                <TextBlock Text="server.planttick — секунды между тиками; меньше = чаще" Style="{StaticResource OctaCmdSub}"/>
                                <Slider x:Name="SldPlantTick" Minimum="10" Maximum="120" Value="60" TickFrequency="10" IsSnapToTickEnabled="True" Margin="0,10,0,4" ValueChanged="Farm_Changed" Tag="T_PlantTick"/>

                                <DockPanel LastChildFill="False" Margin="0,6,0,0">
                                    <TextBlock Text="Шанс гибели вне ящика" Style="{StaticResource OctaCmdTitle}"/>
                                    <TextBlock x:Name="T_WildDeath" Text="0.5%" DockPanel.Dock="Right" Foreground="{StaticResource B.Accent}" FontWeight="Bold"/>
                                </DockPanel>
                                <TextBlock Text="server.nonplanterdeathchancepertick — за тик, в процентах" Style="{StaticResource OctaCmdSub}"/>
                                <Slider x:Name="SldWildDeath" Minimum="0" Maximum="5" Value="0.5" TickFrequency="0.1" IsSnapToTickEnabled="True" Margin="0,10,0,4" ValueChanged="Farm_Changed" Tag="T_WildDeath"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource OctaPanel}" Width="440" Margin="0,0,12,12" Padding="16,14">
                            <StackPanel>
                                <DockPanel LastChildFill="False">
                                    <TextBlock Text="Идеальная влага для качества" Style="{StaticResource OctaCmdTitle}"/>
                                    <TextBlock x:Name="T_Saturation" Text="0.60" DockPanel.Dock="Right" Foreground="{StaticResource B.Accent}" FontWeight="Bold"/>
                                </DockPanel>
                                <TextBlock Text="server.optimalplanterqualitysaturation — насыщение почвы для бонуса качества" Style="{StaticResource OctaCmdSub}"/>
                                <Slider x:Name="SldSaturation" Minimum="0" Maximum="1" Value="0.6" TickFrequency="0.05" IsSnapToTickEnabled="True" Margin="0,10,0,4" ValueChanged="Farm_Changed" Tag="T_Saturation"/>

                                <CheckBox x:Name="ChkLightDetect" Content="Растения реагируют на свет (server.plantlightdetection)" IsChecked="True" Margin="0,10,0,0"/>
                                <CheckBox x:Name="ChkMinCondition" IsChecked="True" Margin="0,6,0,0"><TextBlock Text="Минимальное состояние вместо гибели (server.useminimumplantcondition)" TextWrapping="Wrap"/></CheckBox>

                                <TextBlock Text="Пресеты теплицы" Style="{StaticResource OctaFieldLabel}" Margin="0,14,0,4"/>
                                <StackPanel Orientation="Horizontal">
                                    <ui:Button Content="Ванилла" Padding="12,4" Margin="0,0,6,0" Tag="vanilla" Click="PlantPreset_Click"/>
                                    <ui:Button Content="Быстрый урожай ×3" Padding="12,4" Margin="0,0,6,0" Tag="fast" Click="PlantPreset_Click"/>
                                    <ui:Button Content="Теплица ×5" Padding="12,4" Tag="warm" Click="PlantPreset_Click"/>
                                </StackPanel>

                                <ui:Button Content="⇒ ПРИМЕНИТЬ НАСТРОЙКИ РАСТЕНИЙ" Appearance="Primary" Margin="0,16,0,0" Padding="14,7"
                                           Click="ApplyPlants_Click"
                                           ToolTip="server.* convars — пишет в server.cfg + RCON"/>
                            </StackPanel>
                        </Border>
                    </WrapPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <Border Grid.Row="2" Style="{StaticResource OctaPanel}" Margin="0,12,0,0" Padding="14,8">
            <TextBlock x:Name="TxtStatus" Text="готов" Style="{StaticResource OctaPageSub}" VerticalAlignment="Center"/>
        </Border>
    </Grid>
</Page>
