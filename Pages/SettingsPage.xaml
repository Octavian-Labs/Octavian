<Page x:Class="OctavianRSM.Pages.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      ScrollViewer.CanContentScroll="False"
      Title="Автоматика">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,14">
            <TextBlock Style="{StaticResource OctaPageTitle}" Text="Автоматика"/>
            <TextBlock Style="{StaticResource OctaPageSub}" Text="watchdog и авторестарт — сохраняется в octavian-rsm.json"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <UniformGrid Columns="2">
                <Border Style="{StaticResource OctaPanel}" Margin="0,0,8,8" Padding="16,14">
                    <StackPanel>
                        <TextBlock Text="WATCHDOG" Style="{StaticResource OctaStatLabel}" Margin="0,0,0,10"/>
                        <CheckBox x:Name="ChkWatchdog" Content="Автоподнятие сервера после падения" Foreground="{StaticResource B.Text}" Margin="0,0,0,6"/>
                        <DockPanel LastChildFill="False" Margin="0,0,0,10">
                            <TextBlock Text=" задержка" Style="{StaticResource OctaFieldLabel}" VerticalAlignment="Center"/>
                            <ui:NumberBox x:Name="NumWatchdog" Width="70" Minimum="3" Maximum="300" SpinButtonPlacementMode="Inline" Margin="6,0,0,0"/>
                            <TextBlock Text=" сек" Style="{StaticResource OctaFieldLabel}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                        </DockPanel>
                        <TextBlock Text="Следит за процессом RustDedicated и перезапускает его при вылете." Style="{StaticResource OctaPageSub}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource OctaPanel}" Margin="8,0,0,8" Padding="16,14">
                    <StackPanel>
                        <TextBlock Text="АВТОРЕСТАРТ" Style="{StaticResource OctaStatLabel}" Margin="0,0,0,10"/>
                        <CheckBox x:Name="ChkAutoRestart" Content="Авторестарт по расписанию" Foreground="{StaticResource B.Text}" Margin="0,0,0,6"/>
                        <UniformGrid Columns="2">
                            <StackPanel Margin="0,0,6,0">
                                <TextBlock Text="Время (ЧЧ:мм, через запятую)" Style="{StaticResource OctaFieldLabel}"/>
                                <TextBox x:Name="TxtRestartTimes"/>
                            </StackPanel>
                            <StackPanel Margin="6,0,0,0">
                                <TextBlock Text="Предупреждение, сек" Style="{StaticResource OctaFieldLabel}"/>
                                <TextBox x:Name="TxtRestartWarn"/>
                            </StackPanel>
                        </UniformGrid>
                        <TextBlock Text="рестарт выполняет сам Rust (restart N с анонсами) — watchdog поднимает процесс" Style="{StaticResource OctaPageSub}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
            </UniformGrid>
        </ScrollViewer>

        <Border Grid.Row="2" Style="{StaticResource OctaPanel}" Margin="0,12,0,0" Padding="14,10">
            <DockPanel LastChildFill="False">
                <TextBlock x:Name="TxtSaved" Text="" Style="{StaticResource OctaPageSub}" VerticalAlignment="Center"/>
                <ui:Button DockPanel.Dock="Right" Content="СОХРАНИТЬ" Appearance="Primary" Padding="20,7" Click="Save_Click"/>
            </DockPanel>
        </Border>
    </Grid>
</Page>
