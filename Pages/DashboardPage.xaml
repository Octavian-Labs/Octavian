<Page x:Class="OctavianRSM.Pages.DashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      ScrollViewer.CanContentScroll="False"
      Title="Дашборд">
    <TabControl Margin="16,12,16,0">
        <TabItem Header="ОБЗОР">
    <Grid x:Name="RootGrid" Margin="4,8,4,8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="440"/>
            <ColumnDefinition Width="284"/>
        </Grid.ColumnDefinitions>

        <!-- ══ Центральная колонка: подключение, управление, опции ══ -->
        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="LeftStack">

                <!-- Шапка -->
                <DockPanel Margin="0,0,0,16" LastChildFill="False">
                    <StackPanel>
                        <TextBlock Style="{StaticResource OctaPageTitle}" Text="Дашборд"/>
                        <TextBlock x:Name="TxtSub" Style="{StaticResource OctaPageSub}" Text="сервер Octavian RUST"/>
                    </StackPanel>
                    <ui:Button x:Name="BtnUpdate" Content="⬆ ОБНОВИТЬ" Margin="4" Padding="16,8"
                               Click="BtnUpdate_Click" Visibility="Collapsed"
                               Background="{StaticResource B.AccentSoft}" BorderBrush="{StaticResource B.Accent}"
                               DockPanel.Dock="Right" VerticalAlignment="Center"
                               ToolTip="Доступна новая версия менеджера"/>
                </DockPanel>

                <!-- ПОДКЛЮЧЕНИЕ: адрес для игроков + копирование команды -->
                <TextBlock Text="ПОДКЛЮЧЕНИЕ" Style="{StaticResource OctaSectionHeader}" Margin="0,0,0,8"/>
                <Border Style="{StaticResource OctaPanelAccent}" Padding="16,12" Margin="0,0,0,14">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                    VerticalAlignment="Center" Margin="16,0,0,0">
                            <ui:Button x:Name="BtnCopyConnect" Content="📋 КОПИРОВАТЬ" Appearance="Primary"
                                       Padding="16,8" Click="CopyConnect_Click"
                                       ToolTip="Скопировать команду client.connect в буфер обмена"/>
                            <ui:Button x:Name="BtnSteamConnect" Content="▶ В STEAM" Padding="16,8" Margin="8,0,0,0"
                                       Click="SteamConnect_Click"
                                       ToolTip="steam://run — запустить клиент Rust и сразу подключиться"/>
                        </StackPanel>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="TxtConnectLabel" Text="АДРЕС СЕРВЕРА — вставьте в консоль F1"
                                       Style="{StaticResource OctaStatLabel}"/>
                            <TextBlock x:Name="TxtConnect" Text="определяю адрес…" FontSize="20" FontWeight="Bold"
                                       FontFamily="Consolas" Foreground="{StaticResource B.Accent}" Margin="0,4,0,2"/>
                            <TextBlock x:Name="TxtPorts" Style="{StaticResource OctaPageSub}"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- УПРАВЛЕНИЕ: транспортная панель как в плеере — круглая
                     кнопка Power по центру, меньшие по бокам, статус под ней -->
                <TextBlock Text="УПРАВЛЕНИЕ" Style="{StaticResource OctaSectionHeader}" Margin="0,0,0,8"/>
                <Border Style="{StaticResource OctaPanel}" Padding="10,14" Margin="0,0,0,14">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <ui:Button x:Name="BtnForceSave" Width="42" Height="42" CornerRadius="21" Padding="0"
                                       Content="💾" FontSize="15" Margin="0,16,30,0" Appearance="Secondary"
                                       VerticalAlignment="Center" Click="ForceSave_Click" IsEnabled="False"
                                       ToolTip="FORCE SAVE — server.save через RCON"/>
                            <ui:Button x:Name="BtnRestart" Width="52" Height="52" CornerRadius="26" Padding="0"
                                       Content="↻" FontSize="20" Margin="0,10,22,0" Appearance="Secondary"
                                       VerticalAlignment="Center" Click="BtnRestart_Click" IsEnabled="False"
                                       ToolTip="Перезапустить: save → quit → старт"/>
                            <ui:Button x:Name="BtnPower" Width="76" Height="76" CornerRadius="38" Padding="0"
                                       Content="▶" FontSize="27" VerticalAlignment="Center"
                                       Click="BtnPower_Click"
                                       ToolTip="Запустить / остановить сервер"/>
                            <ui:Button x:Name="BtnKill" Width="42" Height="42" CornerRadius="21" Padding="0"
                                       Content="✕" FontSize="14" Margin="22,16,0,0" Appearance="Secondary"
                                       VerticalAlignment="Center" Click="BtnKill_Click" IsEnabled="False"
                                       ToolTip="KILL — убить процесс без сохранения"/>
                        </StackPanel>
                        <TextBlock x:Name="TxtPowerState" Text="ОСТАНОВЛЕН" FontSize="11" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" Margin="0,10,0,0"
                                   Foreground="{StaticResource B.TextDim}"/>
                        <TextBlock x:Name="TxtActionResult" Style="{StaticResource OctaPageSub}"
                                   HorizontalAlignment="Center" Margin="0,4,0,0"
                                   TextWrapping="Wrap" TextAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- ОПЦИИ: переключатели автоматики — сохраняются сразу -->
                <TextBlock Text="ОПЦИИ" Style="{StaticResource OctaSectionHeader}" Margin="0,0,0,8"/>
                <Border Style="{StaticResource OctaPanel}" Padding="16,12" Margin="0,0,0,14">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,12">
                            <CheckBox x:Name="ChkWatchdog" VerticalAlignment="Top" Click="Opt_Changed"
                                      Foreground="{StaticResource B.Text}"/>
                            <StackPanel Margin="8,0,0,0">
                                <TextBlock Text="Автоподнятие при падении (watchdog)" FontSize="12"
                                           FontWeight="SemiBold" Foreground="{StaticResource B.Text}"/>
                                <TextBlock Text="перезапустит сервер, если он умер не по команде" FontSize="11"
                                           Foreground="{StaticResource B.TextDim}"/>
                            </StackPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="задержка" FontSize="11" Foreground="{StaticResource B.TextDim}"
                                           VerticalAlignment="Center"/>
                                <ui:TextBox x:Name="TxtWatchdogDelay" Width="56" Margin="6,0,0,0"
                                            LostFocus="Opt_Changed" TextAlignment="Center"/>
                                <TextBlock Text="сек" FontSize="11" Foreground="{StaticResource B.TextDim}"
                                           VerticalAlignment="Center" Margin="6,0,0,0"/>
                            </StackPanel>
                        </DockPanel>

                        <DockPanel Margin="0,0,0,12">
                            <CheckBox x:Name="ChkAutoRestart" VerticalAlignment="Top" Click="Opt_Changed"
                                      Foreground="{StaticResource B.Text}"/>
                            <StackPanel Margin="8,0,0,0">
                                <TextBlock Text="Авторестарт по расписанию" FontSize="12"
                                           FontWeight="SemiBold" Foreground="{StaticResource B.Text}"/>
                                <TextBlock Text="restart с предупреждением игроков в заданные часы" FontSize="11"
                                           Foreground="{StaticResource B.TextDim}"/>
                            </StackPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="время" FontSize="11" Foreground="{StaticResource B.TextDim}"
                                           VerticalAlignment="Center"/>
                                <ui:TextBox x:Name="TxtRestartTimes" Width="110" Margin="6,0,0,0"
                                            LostFocus="Opt_Changed" TextAlignment="Center"
                                            ToolTip="HH:mm через запятую, например 04:00, 16:00"/>
                                <TextBlock Text="warn" FontSize="11" Foreground="{StaticResource B.TextDim}"
                                           VerticalAlignment="Center" Margin="10,0,0,0"/>
                                <ui:TextBox x:Name="TxtRestartWarn" Width="50" Margin="6,0,0,0"
                                            LostFocus="Opt_Changed" TextAlignment="Center"/>
                                <TextBlock Text="сек" FontSize="11" Foreground="{StaticResource B.TextDim}"
                                           VerticalAlignment="Center" Margin="6,0,0,0"/>
                            </StackPanel>
                        </DockPanel>

                        <DockPanel>
                            <CheckBox x:Name="ChkAutoWipe" VerticalAlignment="Top" Click="Opt_Changed"
                                      Foreground="{StaticResource B.Text}"/>
                            <StackPanel Margin="8,0,0,0">
                                <TextBlock Text="Автовайп по расписанию" FontSize="12"
                                           FontWeight="SemiBold" Foreground="{StaticResource B.Text}"/>
                                <TextBlock Text="при старте сервера, если вайп просрочен — предложит выполнить" FontSize="11"
                                           Foreground="{StaticResource B.TextDim}"/>
                            </StackPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="каждые" FontSize="11" Foreground="{StaticResource B.TextDim}"
                                           VerticalAlignment="Center"/>
                                <ui:TextBox x:Name="TxtWipeDays" Width="50" Margin="6,0,0,0"
                                            LostFocus="Opt_Changed" TextAlignment="Center"/>
                                <TextBlock Text="дн." FontSize="11" Foreground="{StaticResource B.TextDim}"
                                           VerticalAlignment="Center" Margin="6,0,0,0"/>
                                <CheckBox x:Name="ChkAutoWipeFull" Content="полный" FontSize="11"
                                          Foreground="{StaticResource B.Text}" Margin="12,0,0,0"
                                          Click="Opt_Changed" VerticalAlignment="Center"
                                          ToolTip="Полный вайп (карта + BP) или только карта"/>
                            </StackPanel>
                        </DockPanel>

                        <TextBlock x:Name="TxtOptSaved" FontSize="10" Foreground="{StaticResource B.Success}"
                                   Margin="0,8,0,0" HorizontalAlignment="Right"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ══ Правая колонка: информация о сервере ══ -->
        <Border x:Name="PnlInfo" Grid.Column="1" Style="{StaticResource OctaPanel}" Margin="16,0,0,0" Padding="14,12">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="ИНФОРМАЦИЯ О СЕРВЕРЕ" Style="{StaticResource OctaStatLabel}"
                               Margin="0,0,0,12"/>

                    <DockPanel Margin="0,0,0,9" LastChildFill="False">
                        <TextBlock Text="Состояние" FontSize="11" Foreground="{StaticResource B.TextDim}"/>
                        <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right">
                            <TextBlock x:Name="StatState" Text="—" FontSize="13" FontWeight="Bold"
                                       HorizontalAlignment="Right" Foreground="{StaticResource B.Text}"/>
                            <TextBlock x:Name="StatStateSub" Text="" FontSize="10" HorizontalAlignment="Right"
                                       Foreground="{StaticResource B.TextDim}"/>
                        </StackPanel>
                    </DockPanel>
                    <DockPanel Margin="0,0,0,9" LastChildFill="False">
                        <TextBlock Text="Онлайн" FontSize="11" Foreground="{StaticResource B.TextDim}"/>
                        <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right">
                            <TextBlock x:Name="StatOnline" Text="—" FontSize="13" FontWeight="Bold"
                                       HorizontalAlignment="Right" Foreground="{StaticResource B.Text}"/>
                            <TextBlock x:Name="StatOnlineSub" Text="игроков" FontSize="10"
                                       HorizontalAlignment="Right" Foreground="{StaticResource B.TextDim}"/>
                        </StackPanel>
                    </DockPanel>
                    <DockPanel Margin="0,0,0,9" LastChildFill="False">
                        <TextBlock Text="Очередь / вход" FontSize="11" Foreground="{StaticResource B.TextDim}"/>
                        <TextBlock x:Name="StatQueue" Text="—" FontSize="13" FontWeight="SemiBold"
                                   DockPanel.Dock="Right" Foreground="{StaticResource B.Text}"/>
                    </DockPanel>
                    <DockPanel Margin="0,0,0,9" LastChildFill="False">
                        <TextBlock Text="FPS" FontSize="11" Foreground="{StaticResource B.TextDim}"/>
                        <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right">
                            <TextBlock x:Name="StatFps" Text="—" FontSize="13" FontWeight="Bold"
                                       HorizontalAlignment="Right" Foreground="{StaticResource B.Text}"/>
                            <TextBlock x:Name="StatEntities" Text="" FontSize="10"
                                       HorizontalAlignment="Right" Foreground="{StaticResource B.TextDim}"/>
                        </StackPanel>
                    </DockPanel>
                    <DockPanel Margin="0,0,0,9" LastChildFill="False">
                        <TextBlock Text="Сеть in / out" FontSize="11" Foreground="{StaticResource B.TextDim}"/>
                        <TextBlock x:Name="StatNet" Text="—" FontSize="13" FontWeight="SemiBold"
                                   DockPanel.Dock="Right" Foreground="{StaticResource B.Text}"/>
                    </DockPanel>
                    <DockPanel Margin="0,0,0,9" LastChildFill="False">
                        <TextBlock Text="RAM процесса" FontSize="11" Foreground="{StaticResource B.TextDim}"/>
                        <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right">
                            <TextBlock x:Name="StatRam" Text="—" FontSize="13" FontWeight="SemiBold"
                                       HorizontalAlignment="Right" Foreground="{StaticResource B.Text}"/>
                            <TextBlock x:Name="StatMem" Text="" FontSize="10"
                                       HorizontalAlignment="Right" Foreground="{StaticResource B.TextDim}"/>
                        </StackPanel>
                    </DockPanel>
                    <DockPanel Margin="0,0,0,9" LastChildFill="False">
                        <TextBlock Text="CPU процесса" FontSize="11" Foreground="{StaticResource B.TextDim}"/>
                        <TextBlock x:Name="StatCpu" Text="—" FontSize="13" FontWeight="SemiBold"
                                   DockPanel.Dock="Right" Foreground="{StaticResource B.Text}"/>
                    </DockPanel>
                    <DockPanel Margin="0,0,0,9" LastChildFill="False">
                        <TextBlock Text="Диск свободно" FontSize="11" Foreground="{StaticResource B.TextDim}"/>
                        <TextBlock x:Name="StatDisk" Text="—" FontSize="13" FontWeight="SemiBold"
                                   DockPanel.Dock="Right" Foreground="{StaticResource B.Text}"/>
                    </DockPanel>
                    <DockPanel Margin="0,0,0,9" LastChildFill="False">
                        <TextBlock Text="Аптайм" FontSize="11" Foreground="{StaticResource B.TextDim}"/>
                        <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right">
                            <TextBlock x:Name="StatUptime" Text="—" FontSize="13" FontWeight="Bold"
                                       HorizontalAlignment="Right" Foreground="{StaticResource B.Text}"/>
                            <TextBlock x:Name="StatMap" Text="" FontSize="10"
                                       HorizontalAlignment="Right" Foreground="{StaticResource B.TextDim}"/>
                        </StackPanel>
                    </DockPanel>
                    <DockPanel Margin="0,0,0,9" LastChildFill="False">
                        <TextBlock Text="Последний вайп" FontSize="11" Foreground="{StaticResource B.TextDim}"/>
                        <TextBlock x:Name="StatWipe" Text="—" FontSize="13" FontWeight="SemiBold"
                                   DockPanel.Dock="Right" Foreground="{StaticResource B.Text}"/>
                    </DockPanel>
                    <DockPanel Margin="0,0,0,9" LastChildFill="False">
                        <TextBlock Text="RCON" FontSize="11" Foreground="{StaticResource B.TextDim}"/>
                        <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right">
                            <TextBlock x:Name="StatRcon" Text="—" FontSize="13" FontWeight="Bold"
                                       HorizontalAlignment="Right" Foreground="{StaticResource B.Text}"/>
                            <TextBlock x:Name="StatRconSub" Text="websocket" FontSize="10"
                                       HorizontalAlignment="Right" Foreground="{StaticResource B.TextDim}"/>
                        </StackPanel>
                    </DockPanel>

                    <Border Height="1" Background="{StaticResource B.Border}" Margin="0,6,0,10"/>
                    <TextBlock Text="порты и адрес — в блоке «Подключение» слева"
                               FontSize="10" Foreground="{StaticResource B.TextDim}" TextWrapping="Wrap"/>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
        </TabItem>

        <!-- ══ ЛИЦО СЕРВЕРА: слева настройки, справа живой превью карточки ══ -->
        <TabItem Header="ЛИЦО СЕРВЕРА">
            <Grid Margin="4,8,4,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="430"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="460"/>
                </Grid.ColumnDefinitions>

                <!-- ЛЕВАЯ ПОЛОВИНА: конструктор названия + медиа + публикация -->
                <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                    <StackPanel>

                        <TextBlock Text="НАЗВАНИЕ — конструктор" Style="{StaticResource OctaSectionHeader}" Margin="0,0,0,8"/>
                        <Border Style="{StaticResource OctaPanelAccent}" Padding="16,12" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="ПРЕСЕТЫ" Style="{StaticResource OctaFieldLabel}"/>
                                <WrapPanel x:Name="PnlTitlePresets" Margin="0,0,0,10"/>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="86"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="230"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Регион" Style="{StaticResource OctaFieldLabel}"/>
                                        <ui:TextBox x:Name="InTitleRegion" TextChanged="TitlePart_Changed"
                                                    ToolTip="EU / US — пусто = без префикса [..]"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Имя сервера" Style="{StaticResource OctaFieldLabel}"/>
                                        <ui:TextBox x:Name="InTitleBase" TextChanged="TitlePart_Changed"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="Пати" Style="{StaticResource OctaFieldLabel}"/>
                                        <ComboBox x:Name="CbTitleTeam" SelectionChanged="TitlePart_Changed">
                                            <ComboBoxItem Content="Авто (по лимиту)" Tag="auto" IsSelected="True"/>
                                            <ComboBoxItem Content="Solo" Tag="solo"/>
                                            <ComboBoxItem Content="Duo" Tag="duo"/>
                                            <ComboBoxItem Content="Trio" Tag="trio"/>
                                            <ComboBoxItem Content="Quad" Tag="quad"/>
                                            <ComboBoxItem Content="MAX5" Tag="max5"/>
                                            <ComboBoxItem Content="MAX8" Tag="max8"/>
                                            <ComboBoxItem Content="NoLimit" Tag="nolimit"/>
                                            <ComboBoxItem Content="— скрыть —" Tag="off"/>
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="220"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <DockPanel LastChildFill="False">
                                            <TextBlock Text="Фичи (через запятую)" Style="{StaticResource OctaFieldLabel}" VerticalAlignment="Center"/>
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                <CheckBox x:Name="ChkTitleRates" Content="рейты" FontSize="11"
                                                          VerticalAlignment="Center" IsChecked="True"
                                                          Click="TitlePart_Changed" Foreground="{StaticResource B.TextDim}"
                                                          ToolTip="Показывать рейты в названии"/>
                                                <ui:TextBox x:Name="InTitleRates" Width="96" Margin="6,0,0,0"
                                                            TextChanged="TitlePart_Changed"
                                                            ToolTip="Пусто = авто (из GatherManager/настроек). Впиши своё — хоть x1000000"/>
                                            </StackPanel>
                                        </DockPanel>
                                        <ui:TextBox x:Name="InTitleFeatures" TextChanged="TitlePart_Changed"
                                                    ToolTip="TP, KITS, HOME, LOOT+, SHOP, CLANS, SKINBOX, PVP…"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Вайп" Style="{StaticResource OctaFieldLabel}"/>
                                        <ComboBox x:Name="CbTitleWipe" SelectionChanged="TitlePart_Changed">
                                            <ComboBoxItem Content="Авто (дата)" Tag="auto" IsSelected="True"/>
                                            <ComboBoxItem Content="Свой текст" Tag="custom"/>
                                            <ComboBoxItem Content="— скрыть —" Tag="off"/>
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>
                                <ui:TextBox x:Name="InTitleWipeCustom" Margin="0,0,0,8" Width="220"
                                            HorizontalAlignment="Left" TextChanged="TitlePart_Changed"
                                            ToolTip="Свой текст вайпа, напр. JUST WIPE"/>

                                <DockPanel LastChildFill="False" Margin="0,2,0,0">
                                    <CheckBox x:Name="ChkTitleAuto" Content="авто при смене рейтов/пати"
                                              Foreground="{StaticResource B.TextDim}" FontSize="11" VerticalAlignment="Center"
                                              Click="TitlePart_Changed"/>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="лимит пати" FontSize="11" Foreground="{StaticResource B.TextDim}" VerticalAlignment="Center"/>
                                        <ui:TextBox x:Name="InTeamLimit" Width="52" Margin="6,0,0,0" TextAlignment="Center"
                                                    ToolTip="relationshipmanager.maxteamsize — 0 = тимы выкл."/>
                                        <ui:Button x:Name="BtnTeamApply" Content="OK" Padding="10,4" Margin="6,0,0,0" Click="TeamApply_Click"/>
                                    </StackPanel>
                                </DockPanel>

                                <DockPanel LastChildFill="False" Margin="0,10,0,0">
                                    <ui:Button Content="ПРИМЕНИТЬ НАЗВАНИЕ" Appearance="Primary" Padding="18,8"
                                               Click="TitleApply_Click" DockPanel.Dock="Left"
                                               ToolTip="server.hostname → server.cfg + RCON"/>
                                    <TextBlock x:Name="TxtTitleStatus" Text="" VerticalAlignment="Center" Margin="12,0,0,0"
                                               Foreground="{StaticResource B.TextDim}" FontSize="11" TextWrapping="Wrap"/>
                                </DockPanel>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="МЕДИА И ПУБЛИКАЦИЯ" Style="{StaticResource OctaSectionHeader}" Margin="0,0,0,8"/>
                        <Border Style="{StaticResource OctaPanel}" Padding="16,14" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="Описание (в списке серверов)" Style="{StaticResource OctaFieldLabel}"/>
                                <TextBox x:Name="InFaceDesc" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="56"
                                         Margin="0,0,0,10" TextChanged="FaceField_Changed"/>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Сайт (server.url)" Style="{StaticResource OctaFieldLabel}"/>
                                        <TextBox x:Name="InFaceUrl" TextChanged="FaceField_Changed"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <DockPanel LastChildFill="False">
                                            <TextBlock Text="Теги (server.tags)" Style="{StaticResource OctaFieldLabel}" VerticalAlignment="Center"/>
                                            <ui:Button Content="АВТО" Padding="8,2" FontSize="10" DockPanel.Dock="Right"
                                                       Click="FaceAutoTags_Click" ToolTip="Собрать теги из региона, графика вайпа и режима"/>
                                        </DockPanel>
                                        <TextBox x:Name="InFaceTags" TextChanged="FaceField_Changed"/>
                                    </StackPanel>
                                </Grid>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Баннер (server.headerimage URL)" Style="{StaticResource OctaFieldLabel}"/>
                                        <TextBox x:Name="InFaceHeader" TextChanged="FaceField_Changed"
                                                 ToolTip="PNG/JPG по http(s) — отображается в окне подключения"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Лого (server.logoimage URL)" Style="{StaticResource OctaFieldLabel}"/>
                                        <TextBox x:Name="InFaceLogo" TextChanged="FaceField_Changed"/>
                                    </StackPanel>
                                </Grid>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Домен (server.favoritesEndpoint)" Style="{StaticResource OctaFieldLabel}"/>
                                        <TextBox x:Name="InFaceDomain" ToolTip="A-запись, напр. rust.example.com"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Bottom">
                                        <ui:Button Content="❔ КАК НАСТРОИТЬ ДОМЕН" Style="{StaticResource OctaCmdBtn}"
                                                   Click="FaceDomainGuide_Click" HorizontalAlignment="Left"/>
                                    </StackPanel>
                                </Grid>
                                <DockPanel LastChildFill="False">
                                    <ui:Button Content="ПРОВЕРИТЬ ПУБЛИКАЦИЮ" Style="{StaticResource OctaCmdBtn}"
                                               DockPanel.Dock="Left" Click="FacePublication_Click"/>
                                    <ui:Button Content="СОХРАНИТЬ ЛИЦО" Appearance="Primary" Padding="18,8"
                                               DockPanel.Dock="Right" Click="FaceSave_Click"
                                               ToolTip="server.cfg (+ readcfg при живом сервере)"/>
                                </DockPanel>
                                <TextBlock x:Name="FacePortState" Text="" Margin="0,8,0,0"
                                           Foreground="{StaticResource B.TextDim}" FontSize="11" TextWrapping="Wrap"/>
                                <TextBlock x:Name="FaceValidation" Text="" Margin="0,4,0,0"
                                           Foreground="{StaticResource B.Warn}" FontSize="12" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ПРАВАЯ ПОЛОВИНА: живой превью карточки подключения как в игре -->
                <StackPanel Grid.Column="2">
                    <TextBlock Text="ПРЕВЬЮ — как в списке серверов" Style="{StaticResource OctaSectionHeader}" Margin="0,0,0,8"/>
                    <Border Style="{StaticResource OctaPanelAccent}" Padding="0" Margin="0,0,0,10">
                        <StackPanel>
                            <!-- hostname + теги -->
                            <StackPanel Margin="14,12,14,8">
                                <TextBlock x:Name="TxtTitlePreview" Text="…" FontSize="15" FontWeight="Bold"
                                           FontFamily="Consolas" Foreground="{StaticResource B.Text}"
                                           TextWrapping="Wrap"/>
                                <WrapPanel x:Name="PnlFaceTagsChips" Margin="0,6,0,0"/>
                            </StackPanel>

                            <!-- шапка: баннер + лого в углу -->
                            <Border Height="180" Margin="0,0,0,0" ClipToBounds="True"
                                    Background="#FF0A0D13">
                                <Grid>
                                    <Image x:Name="ImgFaceHeader" Stretch="UniformToFill"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TxtHeaderPlaceholder" Text="server.headerimage — URL картинки шапки"
                                               Foreground="#FF4A5568" FontSize="11"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <Image x:Name="ImgFaceLogo" Width="56" Height="56" Margin="10"
                                           HorizontalAlignment="Left" VerticalAlignment="Top"
                                           Stretch="Uniform" Visibility="Collapsed"/>
                                </Grid>
                            </Border>

                            <!-- строка инфо как в окне подключения -->
                            <Border Background="#FF14181F" Padding="10,7" Margin="0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="ИГРОКИ" Style="{StaticResource OctaStatLabel}"/>
                                        <TextBlock x:Name="TxtFacePlayers" Text="0/0" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{StaticResource B.Text}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="КАРТА" Style="{StaticResource OctaStatLabel}"/>
                                        <TextBlock x:Name="TxtFaceMap" Text="—" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{StaticResource B.Text}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="ВАЙП" Style="{StaticResource OctaStatLabel}"/>
                                        <TextBlock x:Name="TxtFaceWipe" Text="—" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{StaticResource B.Text}"/>
                                    </StackPanel>
                                    <TextBlock x:Name="TxtTitleLen" Text="" Grid.Column="3" VerticalAlignment="Bottom"
                                               Foreground="{StaticResource B.TextDim}" FontSize="10"/>
                                </Grid>
                            </Border>

                            <!-- описание -->
                            <Border Background="#FF0F1318" Padding="14,8">
                                <TextBlock x:Name="TxtFaceDesc" Text="server.description — описание в списке серверов"
                                           Foreground="#FF9AA3AD" FontSize="12" TextWrapping="Wrap" MaxHeight="96"/>
                            </Border>

                            <!-- кнопки как в игре -->
                            <Border Background="#FF14181F" Padding="10,7" Margin="0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="#FF2A3038" CornerRadius="4" Padding="0,6">
                                        <TextBlock x:Name="TxtFaceSite" Text="ВНЕШНИЙ САЙТ" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="#FF9AA3AD" HorizontalAlignment="Center"/>
                                    </Border>
                                    <Border Grid.Column="2" Background="#FF4A6B2F" CornerRadius="4" Padding="0,6"
                                            MouseLeftButtonUp="FaceConnect_Click" Cursor="Hand"
                                            ToolTip="steam://connect — реальное подключение">
                                        <TextBlock Text="▶ ПОДКЛЮЧИТЬСЯ" FontSize="11" FontWeight="Bold"
                                                   Foreground="#FFE9F5D8" HorizontalAlignment="Center"/>
                                    </Border>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="превью живое: меняешь поля слева — карточка обновляется"
                               FontSize="10" Foreground="{StaticResource B.TextDim}" TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
        </TabItem>
    </TabControl>
</Page>
