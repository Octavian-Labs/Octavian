<Page x:Class="OctavianRSM.Pages.ConfigsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      ScrollViewer.CanContentScroll="False"
      xmlns:avalon="http://icsharpcode.net/sharpdevelop/avalonedit"
      Title="Конфиги">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="200" MaxWidth="380"/>
            <ColumnDefinition Width="3*"/>
        </Grid.ColumnDefinitions>

        <DockPanel Grid.ColumnSpan="2" Margin="0,0,0,14" LastChildFill="False">
            <StackPanel>
                <TextBlock Style="{StaticResource OctaPageTitle}" Text="Конфиги сервера"/>
                <TextBlock Style="{StaticResource OctaPageSub}" Text="server/&lt;identity&gt;/cfg • ядро carbon — таблица или текст, Ctrl+S сохранить"/>
            </StackPanel>
            <ui:TextBox DockPanel.Dock="Right" x:Name="TxtSearch" Width="220" PlaceholderText="фильтр файлов…"
                        VerticalAlignment="Center" TextChanged="Search_Changed"/>
        </DockPanel>

        <!-- Файлы слева -->
        <Border Grid.Row="1" Style="{StaticResource OctaPanel}" Margin="0,0,12,0" Padding="0">
            <DockPanel>
                <TextBlock Text="ФАЙЛЫ" Style="{StaticResource OctaStatLabel}" DockPanel.Dock="Top" Margin="14,12,0,8"/>
                <ListBox x:Name="LstFiles" SelectionChanged="LstFiles_SelectionChanged" Margin="4,0">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Style.Triggers>
                                <!-- строки-заголовки групп не выбираются -->
                                <DataTrigger Binding="{Binding IsHeader}" Value="True">
                                    <Setter Property="IsEnabled" Value="False"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsHeader}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource B.Accent2}"/>
                                                <Setter Property="FontSize" Value="10"/>
                                                <Setter Property="FontWeight" Value="Bold"/>
                                                <Setter Property="Margin" Value="0,8,0,2"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Редактор справа -->
        <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource OctaPanel}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Background="{StaticResource B.Bg2}" Padding="14,8" CornerRadius="8,8,0,0">
                    <DockPanel LastChildFill="False">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtFileName" Text="(выберите файл слева)"
                                       Foreground="{StaticResource B.Accent}" FontWeight="SemiBold" FontFamily="Consolas"/>
                            <TextBlock x:Name="TxtDirty" Text="" Foreground="{StaticResource B.Warn}" Margin="10,0,0,0"/>
                        </StackPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:Button x:Name="BtnTable" Content="▦ ТАБЛИЦА" Padding="12,5"
                                       Margin="0,0,6,0" Click="ModeTable_Click"/>
                            <ui:Button x:Name="BtnText" Content="{}{ } ТЕКСТ" Padding="12,5"
                                       Margin="0,0,12,0" Click="ModeText_Click"/>
                            <ui:Button Content="ОТКАТИТЬ" Click="Reload_Click" Padding="12,5" Margin="0,0,8,0"/>
                            <ui:Button Content="СОХРАНИТЬ" Appearance="Primary" Click="Save_Click" Padding="16,5"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Режим таблицы: ключ → значение -->
                <ScrollViewer x:Name="PaneTable" Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="CfgRows" Margin="14,8"/>
                </ScrollViewer>

                <!-- Режим текста -->
                <avalon:TextEditor x:Name="Editor" Grid.Row="1"
                                   ShowLineNumbers="True"
                                   FontFamily="Consolas" FontSize="13.5"
                                   Background="#0B0E14" Foreground="#E6E9EE"
                                   LineNumbersForeground="#4A5568"
                                   HorizontalScrollBarVisibility="Auto"
                                   VerticalScrollBarVisibility="Auto"
                                   BorderThickness="0"
                                   Visibility="Collapsed"
                                   PreviewKeyDown="Editor_KeyDown"
                                   TextChanged="Editor_TextChanged"/>

                <Border Grid.Row="2" Background="{StaticResource B.Bg2}" Padding="14,6" CornerRadius="0,0,8,8">
                    <DockPanel LastChildFill="False">
                        <TextBlock x:Name="TxtPos" Text="Строка 1, столбец 1" Style="{StaticResource OctaPageSub}" FontFamily="Consolas"/>
                        <TextBlock x:Name="TxtInfo" Text="" DockPanel.Dock="Right" Style="{StaticResource OctaPageSub}" FontFamily="Consolas"/>
                    </DockPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Page>
