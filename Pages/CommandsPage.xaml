<Page x:Class="OctavianRSM.Pages.CommandsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      ScrollViewer.CanContentScroll="False"
      Title="Управление">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,14">
            <TextBlock Style="{StaticResource OctaPageTitle}" Text="Управление"/>
            <TextBlock x:Name="TxtRcon" Style="{StaticResource OctaPageSub}" Text="все команды идут через RCON"/>
            <Border Style="{StaticResource OctaPanel}" Padding="10,7" Margin="0,10,0,0">
                <WrapPanel VerticalAlignment="Center">
                    <TextBlock Text="ЦЕЛЬ (ИГРОК):" Style="{StaticResource OctaCmdTitle}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox x:Name="CbTarget" Width="260" Margin="0,0,8,0" VerticalAlignment="Center" DisplayMemberPath="DisplayName" SelectedValuePath="SteamID" SelectionChanged="Target_Changed" ToolTip="Онлайн-игрок для адресных действий"/>
                    <ui:Button Content="ОБНОВИТЬ" Style="{StaticResource OctaCmdBtn}" Margin="0,0,8,0" Click="RefreshPlayers_Click" ToolTip="Обновить playerlist"/>
                    <TextBlock x:Name="TxtTargetHint" Text="выберите цель для адресных действий" Style="{StaticResource OctaCmdSub}" VerticalAlignment="Center" Margin="4,0,0,0"/>
                </WrapPanel>
            </Border>
        </StackPanel>

        <TabControl Grid.Row="1">
            <TabItem Header="ОПЕРАЦИИ">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,4,0,0">
                <WrapPanel x:Name="ServerWrap" Margin="0,0,0,4">
                    <Border Style="{StaticResource OctaCmdCard}">
                        <StackPanel>
                            <TextBlock Text="Сохранение мира" Style="{StaticResource OctaCmdTitle}"/>
                            <TextBlock Text="server.save — принудительный сейв" Style="{StaticResource OctaCmdSub}"/>
                            <ui:Button Content="ВЫПОЛНИТЬ" Margin="0,8,0,0" Tag="server.save" Click="RunSimple"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource OctaCmdCard}">
                        <StackPanel>
                            <TextBlock Text="Записать конфиг" Style="{StaticResource OctaCmdTitle}"/>
                            <TextBlock Text="server.writecfg — сохранить переменные" Style="{StaticResource OctaCmdSub}"/>
                            <ui:Button Content="ВЫПОЛНИТЬ" Margin="0,8,0,0" Tag="server.writecfg" Click="RunSimple"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource OctaCmdCard}">
                        <StackPanel>
                            <TextBlock Text="Рестарт через N сек" Style="{StaticResource OctaCmdTitle}"/>
                            <TextBlock Text="restart — с предупреждением" Style="{StaticResource OctaCmdSub}"/>
                            <ui:NumberBox x:Name="In_RestartSec" Value="60" Minimum="0" Maximum="3600" Margin="0,8,0,6" SpinButtonPlacementMode="Inline"/>
                            <ui:Button Content="РЕСТАРТ" Appearance="Danger" Tag="restart {0}" Click="RunParamConfirm" DataContext="{Binding ElementName=In_RestartSec}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource OctaCmdCard}">
                        <StackPanel>
                            <TextBlock Text="FPS-лимит" Style="{StaticResource OctaCmdTitle}"/>
                            <TextBlock Text="fps.limit (0 = без лимита)" Style="{StaticResource OctaCmdSub}"/>
                            <ui:NumberBox x:Name="In_Fps" Value="0" Minimum="0" Maximum="500" Margin="0,8,0,6" SpinButtonPlacementMode="Inline"/>
                            <ui:Button Content="ПРИМЕНИТЬ" Tag="fps.limit {0}" Click="RunParam" DataContext="{Binding ElementName=In_Fps}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource OctaCmdCard}">
                        <StackPanel>
                            <TextBlock Text="Перечитать server.cfg" Style="{StaticResource OctaCmdTitle}"/>
                            <TextBlock Text="server.readcfg — применить конфиг" Style="{StaticResource OctaCmdSub}"/>
                            <ui:Button Content="ВЫПОЛНИТЬ" Margin="0,8,0,0" Tag="server.readcfg" Click="RunSimple"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource OctaCmdCard}">
                        <StackPanel>
                            <TextBlock Text="Остановка сервера" Style="{StaticResource OctaCmdTitle}"/>
                            <TextBlock Text="quit — штатное завершение" Style="{StaticResource OctaCmdSub}"/>
                            <ui:Button Content="СТОП" Appearance="Danger" Margin="0,8,0,0" Tag="quit" Click="RunConfirm"/>
                        </StackPanel>
                    </Border>
                </WrapPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="ВРЕМЯ И ПОГОДА">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,4,0,0">
                <WrapPanel Margin="0,0,0,4">
                    <Border Style="{StaticResource OctaCmdCardWide}">
                        <StackPanel>
                            <DockPanel LastChildFill="False">
                                <TextBlock Text="Время суток" Style="{StaticResource OctaCmdTitle}"/>
                                <TextBlock x:Name="TxtTimeVal" Text="12.0" DockPanel.Dock="Right" Foreground="{StaticResource B.Accent}" FontWeight="Bold" FontSize="15"/>
                            </DockPanel>
                            <TextBlock Text="env.time — 0..24 часа" Style="{StaticResource OctaCmdSub}"/>
                            <Slider x:Name="SldTime" Minimum="0" Maximum="24" Value="12" TickFrequency="1" IsSnapToTickEnabled="False"
                                    Margin="0,10,0,6" ValueChanged="SldTime_Changed"/>
                            <!-- WrapPanel: широкие кнопки сами переносятся на новую строку -->
                            <WrapPanel HorizontalAlignment="Stretch">
                                <ui:Button Content="РАССВЕТ" Style="{StaticResource OctaCmdBtn}" Tag="env.time 7" Click="RunSimple"/>
                                <ui:Button Content="ПОЛДЕНЬ" Style="{StaticResource OctaCmdBtn}" Tag="env.time 12" Click="RunSimple"/>
                                <ui:Button Content="ЗАКАТ" Style="{StaticResource OctaCmdBtn}" Tag="env.time 19" Click="RunSimple"/>
                                <ui:Button Content="ПОЛНОЧЬ" Style="{StaticResource OctaCmdBtn}" Tag="env.time 0" Click="RunSimple"/>
                                <ui:Button Content="ПРИМЕНИТЬ" Style="{StaticResource OctaCmdBtnPrimary}" Tag="env.time {0}" Click="RunParam" DataContext="{Binding ElementName=SldTime}"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                    <!-- Моментальная погода: пресеты weather.load (Weather 2.0) -->
                    <Border Style="{StaticResource OctaCmdCardWide}">
                        <StackPanel>
                            <TextBlock Text="Моментальная погода" Style="{StaticResource OctaCmdTitle}"/>
                            <TextBlock Text="weather.load — включает пресет сразу, weather.reset — назад в динамику" Style="{StaticResource OctaCmdSub}"/>
                            <WrapPanel Margin="0,6,0,0">
                                <ui:Button Content="☀ ЯСНО" Style="{StaticResource OctaCmdBtn}" Tag="weather.load clear" Click="RunSimple"/>
                                <ui:Button Content="🌁 ПЫЛЬ" Style="{StaticResource OctaCmdBtn}" Tag="weather.load dust" Click="RunSimple"/>
                                <ui:Button Content="🌫 ТУМАН" Style="{StaticResource OctaCmdBtn}" Tag="weather.load fog" Click="RunSimple"/>
                                <ui:Button Content="☁ ПАСМУРНО" Style="{StaticResource OctaCmdBtn}" Tag="weather.load overcast" Click="RunSimple"/>
                                <ui:Button Content="🌦 ДОЖДЬ" Style="{StaticResource OctaCmdBtn}" Tag="weather.load rainmild" Click="RunSimple"/>
                                <ui:Button Content="🌧 ЛИВЕНЬ" Style="{StaticResource OctaCmdBtn}" Tag="weather.load rainheavy" Click="RunSimple"/>
                                <ui:Button Content="⛈ ШТОРМ" Style="{StaticResource OctaCmdBtnDanger}" Tag="weather.load storm" Click="RunSimple"/>
                                <ui:Button Content="↻ ДИНАМИКА" Style="{StaticResource OctaCmdBtn}" Tag="weather.reset" Click="RunSimple"
                                           ToolTip="Вернуть динамическую смену погоды"/>
                                <ui:Button Content="i ОТЧЁТ" Style="{StaticResource OctaCmdBtn}" Tag="weather.report" Click="RunSimple"
                                           ToolTip="Текущие параметры погоды в результат"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <!-- Шансы типов в динамической смене погоды -->
                    <Border Style="{StaticResource OctaCmdCardWide}">
                        <StackPanel>
                            <TextBlock Text="Вероятности погоды" Style="{StaticResource OctaCmdTitle}"/>
                            <TextBlock Text="weather.*_chance 0.0–1.0 — частота каждого типа при динамической смене" Style="{StaticResource OctaCmdSub}" Margin="0,0,0,8"/>
                            <UniformGrid Columns="3">
                                <StackPanel Margin="0,0,8,0">
                                    <DockPanel LastChildFill="False"><TextBlock Text="☀ Ясно" Foreground="{StaticResource B.Text}"/><TextBlock x:Name="T_CClear" DockPanel.Dock="Right" Text="0.5" Foreground="{StaticResource B.TextDim}"/></DockPanel>
                                    <Slider x:Name="SldCClear" Minimum="0" Maximum="1" Value="0.5" TickFrequency="0.1" IsSnapToTickEnabled="True" ValueChanged="Weather_Changed" Tag="T_CClear"/>
                                </StackPanel>
                                <StackPanel Margin="4,0,4,0">
                                    <DockPanel LastChildFill="False"><TextBlock Text="🌫 Туман" Foreground="{StaticResource B.Text}"/><TextBlock x:Name="T_CFog" DockPanel.Dock="Right" Text="0.2" Foreground="{StaticResource B.TextDim}"/></DockPanel>
                                    <Slider x:Name="SldCFog" Minimum="0" Maximum="1" Value="0.2" TickFrequency="0.1" IsSnapToTickEnabled="True" ValueChanged="Weather_Changed" Tag="T_CFog"/>
                                </StackPanel>
                                <StackPanel Margin="8,0,0,0">
                                    <DockPanel LastChildFill="False"><TextBlock Text="🌁 Пыль" Foreground="{StaticResource B.Text}"/><TextBlock x:Name="T_CDust" DockPanel.Dock="Right" Text="0.1" Foreground="{StaticResource B.TextDim}"/></DockPanel>
                                    <Slider x:Name="SldCDust" Minimum="0" Maximum="1" Value="0.1" TickFrequency="0.1" IsSnapToTickEnabled="True" ValueChanged="Weather_Changed" Tag="T_CDust"/>
                                </StackPanel>
                                <StackPanel Margin="0,8,8,0">
                                    <DockPanel LastChildFill="False"><TextBlock Text="☁ Пасмурно" Foreground="{StaticResource B.Text}"/><TextBlock x:Name="T_COver" DockPanel.Dock="Right" Text="0.4" Foreground="{StaticResource B.TextDim}"/></DockPanel>
                                    <Slider x:Name="SldCOver" Minimum="0" Maximum="1" Value="0.4" TickFrequency="0.1" IsSnapToTickEnabled="True" ValueChanged="Weather_Changed" Tag="T_COver"/>
                                </StackPanel>
                                <StackPanel Margin="4,8,4,0">
                                    <DockPanel LastChildFill="False"><TextBlock Text="🌦 Дождь" Foreground="{StaticResource B.Text}"/><TextBlock x:Name="T_CRain" DockPanel.Dock="Right" Text="0.2" Foreground="{StaticResource B.TextDim}"/></DockPanel>
                                    <Slider x:Name="SldCRain" Minimum="0" Maximum="1" Value="0.2" TickFrequency="0.1" IsSnapToTickEnabled="True" ValueChanged="Weather_Changed" Tag="T_CRain"/>
                                </StackPanel>
                                <StackPanel Margin="8,8,0,0">
                                    <DockPanel LastChildFill="False"><TextBlock Text="⛈ Шторм" Foreground="{StaticResource B.Text}"/><TextBlock x:Name="T_CStorm" DockPanel.Dock="Right" Text="0.05" Foreground="{StaticResource B.TextDim}"/></DockPanel>
                                    <Slider x:Name="SldCStorm" Minimum="0" Maximum="1" Value="0.05" TickFrequency="0.05" IsSnapToTickEnabled="True" ValueChanged="Weather_Changed" Tag="T_CStorm"/>
                                </StackPanel>
                            </UniformGrid>
                            <ui:Button Content="⇒ ПРИМЕНИТЬ ВЕРОЯТНОСТИ (все 6 типов)" Style="{StaticResource OctaCmdBtnPrimary}" Margin="0,12,0,0" Click="ApplyWeather_Click"/>
                        </StackPanel>
                    </Border>

                    <!-- Интенсивности атмосферы -->
                    <Border Style="{StaticResource OctaCmdCardWide}">
                        <StackPanel>
                            <TextBlock Text="Атмосфера и интенсивность" Style="{StaticResource OctaCmdTitle}"/>
                            <TextBlock Text="weather.rain / fog / wind / thunder — сила явления 0.0–1.0 прямо сейчас" Style="{StaticResource OctaCmdSub}" Margin="0,0,0,8"/>
                            <UniformGrid Columns="2">
                                <StackPanel Margin="0,0,8,0">
                                    <DockPanel LastChildFill="False"><TextBlock Text="Дождь" Foreground="{StaticResource B.Text}"/><TextBlock x:Name="T_Rain" DockPanel.Dock="Right" Text="0" Foreground="{StaticResource B.TextDim}"/></DockPanel>
                                    <Slider x:Name="SldRain" Minimum="0" Maximum="1" Value="0" TickFrequency="0.1" IsSnapToTickEnabled="True" ValueChanged="Weather_Changed" Tag="T_Rain"/>
                                </StackPanel>
                                <StackPanel Margin="8,0,0,0">
                                    <DockPanel LastChildFill="False"><TextBlock Text="Туман" Foreground="{StaticResource B.Text}"/><TextBlock x:Name="T_Fog" DockPanel.Dock="Right" Text="0" Foreground="{StaticResource B.TextDim}"/></DockPanel>
                                    <Slider x:Name="SldFog" Minimum="0" Maximum="1" Value="0" TickFrequency="0.1" IsSnapToTickEnabled="True" ValueChanged="Weather_Changed" Tag="T_Fog"/>
                                </StackPanel>
                                <StackPanel Margin="0,8,8,0">
                                    <DockPanel LastChildFill="False"><TextBlock Text="Ветер" Foreground="{StaticResource B.Text}"/><TextBlock x:Name="T_Wind" DockPanel.Dock="Right" Text="0" Foreground="{StaticResource B.TextDim}"/></DockPanel>
                                    <Slider x:Name="SldWind" Minimum="0" Maximum="1" Value="0" TickFrequency="0.1" IsSnapToTickEnabled="True" ValueChanged="Weather_Changed" Tag="T_Wind"/>
                                </StackPanel>
                                <StackPanel Margin="8,8,0,0">
                                    <DockPanel LastChildFill="False"><TextBlock Text="Гроза" Foreground="{StaticResource B.Text}"/><TextBlock x:Name="T_Storm" DockPanel.Dock="Right" Text="0" Foreground="{StaticResource B.TextDim}"/></DockPanel>
                                    <Slider x:Name="SldStorm" Minimum="0" Maximum="1" Value="0" TickFrequency="0.1" IsSnapToTickEnabled="True" ValueChanged="Weather_Changed" Tag="T_Storm"/>
                                </StackPanel>
                            </UniformGrid>
                            <WrapPanel Margin="0,10,0,0">
                                <ui:Button Content="⇒ ИНТЕНСИВНОСТЬ" Style="{StaticResource OctaCmdBtnPrimary}" Click="ApplyAtmos_Click"/>
                                <ui:Button Content="🌈 РАДУГА" Style="{StaticResource OctaCmdBtn}" Tag="weather.rainbow 1" Click="RunSimple" ToolTip="Включить радугу"/>
                                <ui:Button Content="✕ СБРОС" Style="{StaticResource OctaCmdBtn}" Tag="weather.reset" Click="RunSimple"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </WrapPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="ИГРОКИ И МОДЕРАЦИЯ">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,4,0,0">
                <WrapPanel x:Name="PlayersWrap" Margin="0,0,0,4">
                    <TextBlock Text="ДЕЙСТВИЯ С ВЫБРАННОЙ ЦЕЛЬЮ" Style="{StaticResource OctaCmdTitle}" FontSize="13" Width="{Binding ActualWidth, ElementName=PlayersWrap}" Margin="16,8,0,2"/>
                    <Border Style="{StaticResource OctaCmdCardWide}">
                        <StackPanel>
                            <TextBlock Text="Состояние и администрация" Style="{StaticResource OctaCmdTitle}"/>
                            <TextBlock Text="команды применяются к игроку из глобального поля ЦЕЛЬ" Style="{StaticResource OctaCmdSub}"/>
                            <WrapPanel Margin="0,10,0,0">
                                <ui:Button Content="ПОЗИЦИЯ" Style="{StaticResource OctaCmdBtn}" Tag="octa.targetinfo {0}" Click="TargetCommand_Click"/>
                                <ui:Button Content="COMBATLOG" Style="{StaticResource OctaCmdBtn}" Tag="combatlog {0}" Click="TargetCommand_Click"/>
                                <ui:Button Content="ЛЕЧИТЬ" Style="{StaticResource OctaCmdBtnPrimary}" Tag="octa.heal {0}" Click="TargetCommand_Click"/>
                                <ui:Button Content="ПОДНЯТЬ" Style="{StaticResource OctaCmdBtnPrimary}" Tag="octa.revive {0}" Click="TargetCommand_Click"/>
                                <ui:Button Content="GOD ON" Style="{StaticResource OctaCmdBtn}" Tag="octa.god {0} true" Click="TargetCommandConfirm_Click"/>
                                <ui:Button Content="GOD OFF" Style="{StaticResource OctaCmdBtn}" Tag="octa.god {0} false" Click="TargetCommand_Click"/>
                                <ui:Button Content="УБИТЬ" Style="{StaticResource OctaCmdBtnDanger}" Tag="octa.kill {0}" Click="TargetCommandConfirm_Click"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource OctaCmdCardWide}">
                        <StackPanel>
                            <TextBlock Text="Телепорт цели" Style="{StaticResource OctaCmdTitle}"/>
                            <TextBlock Text="по координатам либо к другому онлайн-игроку" Style="{StaticResource OctaCmdSub}"/>
                            <ui:TextBox x:Name="In_TargetPos" Margin="0,8,0,6" PlaceholderText="x y z, например 1200 10 -900"/>
                            <ui:Button Content="В КООРДИНАТЫ" Style="{StaticResource OctaCmdBtn}" Click="TeleportTargetPos_Click"/>
                            <ComboBox x:Name="CbTeleportDest" Margin="0,8,0,6" DisplayMemberPath="DisplayName" SelectedValuePath="SteamID" ToolTip="Игрок назначения"/>
                            <ui:Button Content="К ИГРОКУ" Style="{StaticResource OctaCmdBtnPrimary}" Click="TeleportTarget_Click"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="ДОСТУП, ОЧЕРЕДЬ И ИНВЕНТАРЬ" Style="{StaticResource OctaCmdTitle}" FontSize="13" Width="{Binding ActualWidth, ElementName=PlayersWrap}" Margin="16,10,0,2"/>
                    <Border Style="{StaticResource OctaCmdCardWide}">
                        <StackPanel>
                            <TextBlock Text="Очередь и режим обслуживания" Style="{StaticResource OctaCmdTitle}"/>
                            <TextBlock Text="админы проходят всегда; whitelist действует только во время техработ" Style="{StaticResource OctaCmdSub}"/>
                            <WrapPanel Margin="0,8,0,0">
                                <ui:Button Content="ОЧЕРЕДЬ / INFO" Style="{StaticResource OctaCmdBtn}" Tag="serverinfo" Click="RunSimple" ToolTip="serverinfo содержит Queued и Joining; голая команда queue в текущей сборке Rust падает с FormatException"/>
                                <ui:Button Content="PRIORITY +" Style="{StaticResource OctaCmdBtn}" Tag="skipqueueid {0}" Click="TargetCommand_Click"/>
                                <ui:Button Content="PRIORITY −" Style="{StaticResource OctaCmdBtn}" Tag="removeskipqueue {0}" Click="TargetCommand_Click"/>
                                <ui:Button Content="ALLOW +" Style="{StaticResource OctaCmdBtn}" Tag="octa.allow add {0}" Click="TargetCommand_Click"/>
                                <ui:Button Content="ALLOW −" Style="{StaticResource OctaCmdBtn}" Tag="octa.allow remove {0}" Click="TargetCommand_Click"/>
                                <ui:Button Content="ALLOW LIST" Style="{StaticResource OctaCmdBtn}" Tag="octa.allow list" Click="RunSimple"/>
                                <ui:Button Content="СТАТУС" Style="{StaticResource OctaCmdBtn}" Tag="octa.maintenance status" Click="RunSimple"/>
                            </WrapPanel>
                            <ui:TextBox x:Name="In_AccessSteamId" Margin="0,8,0,6" PlaceholderText="SteamID офлайн-игрока (необязательно)"/>
                            <WrapPanel>
                                <ui:Button Content="PRIORITY ID +" Style="{StaticResource OctaCmdBtn}" Tag="skipqueueid {0}" Click="AccessIdCommand_Click"/>
                                <ui:Button Content="PRIORITY ID −" Style="{StaticResource OctaCmdBtn}" Tag="removeskipqueue {0}" Click="AccessIdCommand_Click"/>
                                <ui:Button Content="ALLOW ID +" Style="{StaticResource OctaCmdBtn}" Tag="octa.allow add {0}" Click="AccessIdCommand_Click"/>
                                <ui:Button Content="ALLOW ID −" Style="{StaticResource OctaCmdBtn}" Tag="octa.allow remove {0}" Click="AccessIdCommand_Click"/>
                            </WrapPanel>
                            <ui:TextBox x:Name="In_MaintMessage" Margin="0,8,0,6" PlaceholderText="Технические работы. Попробуйте позже."/>
                            <WrapPanel>
                                <ui:Button Content="ТЕХРАБОТЫ ON" Style="{StaticResource OctaCmdBtnDanger}" Click="MaintenanceOn_Click"/>
                                <ui:Button Content="ТЕХРАБОТЫ OFF" Style="{StaticResource OctaCmdBtnPrimary}" Tag="octa.maintenance off" Click="RunConfirm"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource OctaCmdCardWide}">
                        <StackPanel>
                            <TextBlock Text="Loadout и предметы" Style="{StaticResource OctaCmdTitle}"/>
                            <TextBlock Text="выдача выбранной цели; loadout создаётся в F1 через inventory.saveloadout" Style="{StaticResource OctaCmdSub}"/>
                            <Grid Margin="0,8,0,6"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions><ui:TextBox x:Name="In_GiveItem" PlaceholderText="shortname, например wood"/><ui:NumberBox x:Name="In_GiveAmount" Grid.Column="2" Value="1" Minimum="1" Maximum="1000000" SpinButtonPlacementMode="Inline"/></Grid>
                            <ui:Button Content="ВЫДАТЬ ПРЕДМЕТ" Style="{StaticResource OctaCmdBtnPrimary}" Click="GiveTarget_Click"/>
                            <ui:TextBox x:Name="In_Loadout" Margin="0,8,0,6" PlaceholderText="имя loadout"/>
                            <WrapPanel>
                                <ui:Button Content="СПИСОК" Style="{StaticResource OctaCmdBtn}" Tag="inventory.listloadouts" Click="RunSimple"/>
                                <ui:Button Content="ВЫДАТЬ LOADOUT" Style="{StaticResource OctaCmdBtnPrimary}" Click="DeployLoadout_Click"/>
                                <ui:Button Content="ОЧИСТИТЬ ИНВЕНТАРЬ" Style="{StaticResource OctaCmdBtnDanger}" Tag="octa.strip {0}" Click="TargetCommandConfirm_Click"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="БАЗОВАЯ МОДЕРАЦИЯ" Style="{StaticResource OctaCmdTitle}" FontSize="13" Width="{Binding ActualWidth, ElementName=PlayersWrap}" Margin="16,10,0,2"/>
                    <Border Style="{StaticResource OctaCmdCard}">
                        <StackPanel>
                            <TextBlock Text="Кикнуть" Style="{StaticResource OctaCmdTitle}"/>
                            <TextBlock Text="kick steamid причина" Style="{StaticResource OctaCmdSub}"/>
                            <ui:TextBox x:Name="In_Kick" Margin="0,8,0,6" PlaceholderText="76561... reason"/>
                            <ui:Button Content="KICK" Tag="kick {0}" Click="RunParamConfirm" DataContext="{Binding ElementName=In_Kick}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource OctaCmdCard}">
                        <StackPanel>
                            <TextBlock Text="Разбанить" Style="{StaticResource OctaCmdTitle}"/>
                            <TextBlock Text="unban steamid" Style="{StaticResource OctaCmdSub}"/>
                            <ui:TextBox x:Name="In_Unban" Margin="0,8,0,6" PlaceholderText="76561..."/>
                            <ui:Button Content="UNBAN" Tag="unban {0}" Click="RunParam" DataContext="{Binding ElementName=In_Unban}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource OctaCmdCard}">
                        <StackPanel>
                            <TextBlock Text="Мут чата" Style="{StaticResource OctaCmdTitle}"/>
                            <TextBlock Text="mute / unmute steamid" Style="{StaticResource OctaCmdSub}"/>
                            <ui:TextBox x:Name="In_Mute" Margin="0,8,0,6" PlaceholderText="76561..."/>
                            <StackPanel Orientation="Horizontal">
                                <ui:Button Content="MUTE" Margin="0,0,6,0" Tag="mute {0}" Click="RunParam" DataContext="{Binding ElementName=In_Mute}"/>
                                <ui:Button Content="UNMUTE" Tag="unmute {0}" Click="RunParam" DataContext="{Binding ElementName=In_Mute}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource OctaCmdCard}">
                        <StackPanel>
                            <TextBlock Text="Назначить модера" Style="{StaticResource OctaCmdTitle}"/>
                            <TextBlock Text="moderatorid steamid ник" Style="{StaticResource OctaCmdSub}"/>
                            <ui:TextBox x:Name="In_Mod" Margin="0,8,0,6" PlaceholderText="76561... Nick"/>
                            <ui:Button Content="НАЗНАЧИТЬ" Tag="moderatorid {0}" Click="RunParamConfirm" DataContext="{Binding ElementName=In_Mod}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource OctaCmdCard}">
                        <StackPanel>
                            <TextBlock Text="Выдать OWNER" Style="{StaticResource OctaCmdTitle}"/>
