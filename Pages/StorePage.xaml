<Page x:Class="OctavianRSM.Pages.StorePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
      ScrollViewer.CanContentScroll="False"
      Title="Магазин">
    <Grid Margin="20,16,20,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,10" LastChildFill="False">
            <StackPanel>
                <TextBlock Style="{StaticResource OctaPageTitle}" Text="Магазин плагинов"/>
                <TextBlock Style="{StaticResource OctaPageSub}" Text="codefling.com — скачанные .cs/.zip автоматически попадают в carbon/plugins"/>
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <ui:Button Content="⟳ ВЕРСИИ" Appearance="Secondary" Padding="12,5" Margin="0,0,8,0"
                           Click="CheckVersions_Click" ToolTip="Сверить версии установленных плагинов с codefling"/>
            </StackPanel>
        </DockPanel>

        <!-- Панель навигации -->
        <Border Grid.Row="1" Style="{StaticResource OctaPanel}" Padding="8,6" Margin="0,0,0,10">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <ui:Button Content="←" Padding="10,3" Click="Back_Click" ToolTip="Назад"/>
                    <ui:Button Content="→" Padding="10,3" Margin="6,0,0,0" Click="Forward_Click" ToolTip="Вперёд"/>
                    <ui:Button Content="⟳" Padding="10,3" Margin="6,0,0,0" Click="Reload_Click" ToolTip="Обновить"/>
                    <ui:Button Content="⌂" Padding="10,3" Margin="6,0,0,0" Click="Home_Click" ToolTip="codefling.com"/>
                </StackPanel>
                <TextBlock x:Name="TxtUrl" DockPanel.Dock="Right" Style="{StaticResource OctaPageSub}"
                           FontFamily="Consolas" FontSize="11" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" Margin="12,0,4,0"/>
            </DockPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource OctaPanel}" Padding="0">
            <Grid>
                <wv2:WebView2 x:Name="Web"/>
                <StackPanel x:Name="WebFallback" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="WebView2 недоступен" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    <TextBlock Text="Откройте codefling.com в обычном браузере" Style="{StaticResource OctaPageSub}"
                               HorizontalAlignment="Center" Margin="0,6,0,10"/>
                    <ui:Button Content="ОТКРЫТЬ В БРАУЗЕРЕ" Appearance="Primary" Padding="16,6"
                               HorizontalAlignment="Center" Click="OpenExternal_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="3" Style="{StaticResource OctaPanel}" Margin="0,10,0,0" Padding="12,6">
            <DockPanel LastChildFill="False">
                <TextBlock x:Name="TxtStatus" Text="загрузка браузера…" Style="{StaticResource OctaPageSub}" VerticalAlignment="Center"/>
                <TextBlock x:Name="TxtDll" DockPanel.Dock="Right" Style="{StaticResource OctaPageSub}" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>
    </Grid>
</Page>
