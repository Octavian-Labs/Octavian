<Page x:Class="OctavianRSM.Pages.AppSettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      ScrollViewer.CanContentScroll="False"
      Title="Настройки">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,14">
            <TextBlock Style="{StaticResource OctaPageTitle}" Text="Настройки"/>
            <TextBlock Style="{StaticResource OctaPageSub}" Text="приложение менеджера — версия, обновления, файлы, мастер"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <UniformGrid Columns="2">
                <StackPanel Margin="0,0,8,0">
                    <!-- Обновление -->
                    <Border Style="{StaticResource OctaPanel}" Margin="0,0,0,12" Padding="16,14">
                        <StackPanel>
                            <TextBlock Text="ВЕРСИЯ И ОБНОВЛЕНИЕ" Style="{StaticResource OctaStatLabel}" Margin="0,0,0,10"/>
                            <DockPanel LastChildFill="False" Margin="0,0,0,10">
                                <TextBlock x:Name="TxtVersion" Style="{StaticResource OctaStatValue}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtUpdate" DockPanel.Dock="Right" FontSize="11"
                                           Foreground="{StaticResource B.TextDim}" VerticalAlignment="Center"/>
                            </DockPanel>
                            <ProgressBar x:Name="UpdateProgress" Height="4" Minimum="0" Maximum="1"
                                         Visibility="Collapsed" Margin="0,0,0,10"/>
                            <UniformGrid Columns="2">
                                <ui:Button Content="ПРОВЕРИТЬ" Margin="0,0,4,0" Click="CheckUpdate_Click"/>
                                <ui:Button x:Name="BtnApplyUpdate" Content="УСТАНОВИТЬ" Appearance="Primary"
                                           Margin="4,0,0,0" IsEnabled="False" Click="ApplyUpdate_Click"/>
                            </UniformGrid>
                            <TextBlock x:Name="TxtUpdateNotes" TextWrapping="Wrap" Margin="0,10,0,0"
                                       Foreground="{StaticResource B.TextDim}" FontSize="11" MaxHeight="120"/>
                        </StackPanel>
                    </Border>

                    <!-- Мастер -->
                    <Border Style="{StaticResource OctaPanel}" Padding="16,14">
                        <StackPanel>
                            <TextBlock Text="МАСТЕР УСТАНОВКИ" Style="{StaticResource OctaStatLabel}" Margin="0,0,0,8"/>
                            <TextBlock Text="Повторный запуск мастера: папки, SteamCMD, базовые настройки."
                                       TextWrapping="Wrap" Foreground="{StaticResource B.TextDim}" FontSize="11" Margin="0,0,0,10"/>
                            <ui:Button Content="ЗАПУСТИТЬ МАСТЕР" Padding="14,4" HorizontalAlignment="Left"
                                       Click="Wizard_Click"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Файлы приложения -->
                <StackPanel Margin="8,0,0,0">
                    <Border Style="{StaticResource OctaPanel}" Margin="0,0,0,12" Padding="16,14">
                        <StackPanel>
                            <TextBlock Text="ФАЙЛЫ ПРИЛОЖЕНИЯ" Style="{StaticResource OctaStatLabel}" Margin="0,0,0,10"/>
                            <TextBlock Text="Конфиг менеджера" Style="{StaticResource OctaFieldLabel}"/>
                            <DockPanel LastChildFill="False" Margin="0,0,0,10">
                                <TextBlock x:Name="TxtCfgPath" Style="{StaticResource OctaMono}" FontSize="10"
                                           Foreground="{StaticResource B.TextDim}" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/>
                                <ui:Button Content="ОТКРЫТЬ" Padding="10,3" FontSize="10" DockPanel.Dock="Right"
                                           Click="OpenCfg_Click"/>
                            </DockPanel>
                            <TextBlock Text="Данные (логи, БД, crash.log)" Style="{StaticResource OctaFieldLabel}"/>
                            <DockPanel LastChildFill="False" Margin="0,0,0,10">
                                <TextBlock x:Name="TxtDataPath" Style="{StaticResource OctaMono}" FontSize="10"
                                           Foreground="{StaticResource B.TextDim}" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/>
                                <ui:Button Content="ОТКРЫТЬ" Padding="10,3" FontSize="10" DockPanel.Dock="Right"
                                           Click="OpenData_Click"/>
                            </DockPanel>
                            <TextBlock Text="Исполняемый файл" Style="{StaticResource OctaFieldLabel}"/>
                            <TextBlock x:Name="TxtExePath" Style="{StaticResource OctaMono}" FontSize="10"
                                       Foreground="{StaticResource B.TextDim}" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </UniformGrid>
        </ScrollViewer>
    </Grid>
</Page>
