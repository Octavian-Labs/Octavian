<UserControl x:Class="OctavianRSM.Controls.SettingRow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="500">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="180"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
            <DockPanel LastChildFill="False">
                <TextBlock x:Name="TxtTitle" FontSize="12" FontWeight="SemiBold"
                           Foreground="{StaticResource B.Text}"/>
                <Border x:Name="LockBadge" Style="{StaticResource OctaChip}" Padding="7,1"
                        Margin="8,0,0,0" DockPanel.Dock="Right" Visibility="Collapsed">
                    <TextBlock x:Name="TxtLock" FontSize="10" Foreground="{StaticResource B.Warn}"/>
                </Border>
            </DockPanel>
            <TextBlock x:Name="TxtHint" FontSize="11" TextWrapping="Wrap"
                       Foreground="{StaticResource B.TextDim}" Margin="0,2,0,0"/>
        </StackPanel>
        <ContentPresenter x:Name="EditorHost" Grid.Column="1" VerticalAlignment="Center"
                          HorizontalAlignment="Right"/>
    </Grid>
</UserControl>
