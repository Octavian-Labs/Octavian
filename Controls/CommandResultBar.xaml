<UserControl x:Class="OctavianRSM.Controls.CommandResultBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="700">
    <StackPanel>
        <!-- Развёрнутый полный ответ -->
        <Border x:Name="PnlFull" Style="{StaticResource OctaPanel}" Margin="0,0,0,8"
                Padding="0" Visibility="Collapsed" MaxHeight="260">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <DockPanel Margin="12,8" LastChildFill="True">
                    <TextBlock x:Name="TxtFullTitle" Text="ПОЛНЫЙ ОТВЕТ СЕРВЕРА"
                               Style="{StaticResource OctaCmdTitle}" DockPanel.Dock="Left"
                               VerticalAlignment="Center"/>
                    <ui:Button Content="КОПИРОВАТЬ" DockPanel.Dock="Right"
                               Style="{StaticResource OctaCmdBtn}" Margin="0" Padding="10,4"
                               Click="Copy_Click"/>
                    <ui:Button Content="ОЧИСТИТЬ" DockPanel.Dock="Right"
                               Style="{StaticResource OctaCmdBtn}" Margin="0,0,6,0" Padding="10,4"
                               Click="Clear_Click"/>
                </DockPanel>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                              Margin="12,0,12,12" Background="#10000000">
                    <TextBlock x:Name="TxtFull" Style="{StaticResource OctaPageSub}"
                               TextWrapping="Wrap" FontFamily="Consolas" Padding="8"/>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Сжатая строка результата -->
        <Border Style="{StaticResource OctaPanel}" Padding="14,8">
            <DockPanel LastChildFill="False">
                <TextBlock x:Name="TxtState" Text="готов" Style="{StaticResource OctaPageSub}"
                           VerticalAlignment="Center"/>
                <ui:Button x:Name="BtnExpand" Content="▲" DockPanel.Dock="Right"
                           Style="{StaticResource OctaCmdBtn}" Margin="0" Padding="10,2"
                           MinWidth="36" ToolTip="Развернуть полный ответ" Click="Expand_Click"/>
                <TextBlock x:Name="TxtResult" DockPanel.Dock="Right"
                           Style="{StaticResource OctaPageSub}" VerticalAlignment="Center"
                           MaxWidth="560" MaxHeight="40" Margin="0,0,8,0"
                           TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>
    </StackPanel>
</UserControl>
